rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDashboard(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 50 &&
             data.isDefault is bool &&
             data.widgets is list &&
             data.widgets.size() <= 24 &&
             (data.widgets.size() == 0 || data.widgets[0] is map) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCustomPid(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.pidKey is string &&
             data.pidKey.size() >= 1 &&
             data.pidKey.size() <= 40 &&
             data.label is string &&
             data.label.size() >= 1 &&
             data.label.size() <= 50 &&
             data.command is string &&
             data.command.size() >= 2 &&
             data.command.size() <= 16 &&
             data.canHeader is string &&
             data.canHeader.size() <= 8 &&
             data.unit is string &&
             data.unit.size() <= 16 &&
             data.formula is string &&
             data.formula.size() >= 1 &&
             data.formula.size() <= 80 &&
             data.minValue is number &&
             data.maxValue is number &&
             data.maxValue >= data.minValue &&
             data.targetWheel is string &&
             data.targetWheel.size() <= 8 &&
             data.targetWheel in ['', 'FL', 'FR', 'RL', 'RR'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/dashboards/{dashboardId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(dashboardId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(dashboardId) &&
                       incoming().keys().hasAll(['userId', 'name', 'isDefault', 'widgets', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'isDefault', 'widgets', 'createdAt', 'updatedAt']) &&
                       isValidDashboard(incoming(), userId);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(dashboardId) &&
                       isValidDashboard(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'isDefault', 'widgets', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(dashboardId);
    }

    match /users/{userId}/custom_pids/{pidId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(pidId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(pidId) &&
                       incoming().keys().hasAll([
                         'userId', 'pidKey', 'label', 'command', 'canHeader',
                         'unit', 'formula', 'minValue', 'maxValue', 'targetWheel',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'pidKey', 'label', 'command', 'canHeader',
                         'unit', 'formula', 'minValue', 'maxValue', 'targetWheel',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidCustomPid(incoming(), userId);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(pidId) &&
                       isValidCustomPid(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'pidKey', 'label', 'command', 'canHeader',
                         'unit', 'formula', 'minValue', 'maxValue', 'targetWheel', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(pidId);
    }

    function isValidTripLog(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 60 &&
             data.startedAtMillis is number &&
             data.startedAtMillis >= 0 &&
             data.endedAtMillis is number &&
             data.endedAtMillis >= 0 &&
             data.durationSec is number &&
             data.durationSec >= 0 &&
             data.sampleCount is number &&
             data.sampleCount >= 0 &&
             data.distanceKm is number &&
             data.distanceKm >= 0 &&
             data.avgSpeedKmh is number &&
             data.avgSpeedKmh >= 0 &&
             data.maxSpeedKmh is number &&
             data.maxSpeedKmh >= 0 &&
             data.maxRpm is number &&
             data.maxRpm >= 0 &&
             data.maxCoolantC is number &&
             data.maxDpfTempC is number &&
             data.minBatteryV is number &&
             data.minBatteryV >= 0 &&
             data.maxBatteryV is number &&
             data.maxBatteryV >= 0 &&
             data.avgBatteryV is number &&
             data.avgBatteryV >= 0 &&
             data.maxTurboKpa is number &&
             data.maxTurboKpa >= 0 &&
             data.estimatedFuelLiters is number &&
             data.estimatedFuelLiters >= 0 &&
             data.avgLitersPer100Km is number &&
             data.avgLitersPer100Km >= 0 &&
             data.avgLitersPerHour is number &&
             data.avgLitersPerHour >= 0 &&
             data.trafficSeconds is number &&
             data.trafficSeconds >= 0 &&
             data.dpfRegenDetected is bool &&
             data.dpfRegenSeconds is number &&
             data.dpfRegenSeconds >= 0 &&
             data.csvFileName is string &&
             data.csvFileName.size() >= 1 &&
             data.csvFileName.size() <= 80 &&
             data.status is string &&
             data.status in ['RECORDING', 'COMPLETED'] &&
             data.demoMode is bool &&
             data.timelinePoints is list &&
             data.timelinePoints.size() <= 60 &&
             (data.timelinePoints.size() == 0 || data.timelinePoints[0] is map) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/trip_logs/{tripId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(tripId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(tripId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'startedAtMillis', 'endedAtMillis', 'durationSec',
                         'sampleCount', 'distanceKm', 'avgSpeedKmh', 'maxSpeedKmh', 'maxRpm',
                         'maxCoolantC', 'maxDpfTempC', 'minBatteryV', 'maxBatteryV', 'avgBatteryV',
                         'maxTurboKpa', 'estimatedFuelLiters', 'avgLitersPer100Km',
                         'avgLitersPerHour', 'trafficSeconds', 'dpfRegenDetected', 'dpfRegenSeconds',
                         'csvFileName', 'status', 'demoMode', 'timelinePoints',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'startedAtMillis', 'endedAtMillis', 'durationSec',
                         'sampleCount', 'distanceKm', 'avgSpeedKmh', 'maxSpeedKmh', 'maxRpm',
                         'maxCoolantC', 'maxDpfTempC', 'minBatteryV', 'maxBatteryV', 'avgBatteryV',
                         'maxTurboKpa', 'estimatedFuelLiters', 'avgLitersPer100Km',
                         'avgLitersPerHour', 'trafficSeconds', 'dpfRegenDetected', 'dpfRegenSeconds',
                         'csvFileName', 'status', 'demoMode', 'timelinePoints',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidTripLog(incoming(), userId);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(tripId) &&
                       isValidTripLog(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().startedAtMillis == existing().startedAtMillis &&
                       incoming().csvFileName == existing().csvFileName &&
                       incoming().demoMode == existing().demoMode &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'endedAtMillis', 'durationSec', 'sampleCount', 'distanceKm',
                         'avgSpeedKmh', 'maxSpeedKmh', 'maxRpm', 'maxCoolantC', 'maxDpfTempC',
                         'minBatteryV', 'maxBatteryV', 'avgBatteryV', 'maxTurboKpa',
                         'estimatedFuelLiters', 'avgLitersPer100Km', 'avgLitersPerHour',
                         'trafficSeconds', 'dpfRegenDetected', 'dpfRegenSeconds',
                         'status', 'timelinePoints', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(tripId);
    }
  }
}
